OPENAI_API_KEY=sk-...

# LangSmith is the trace/debug surface only. Cost is computed in-process.
# Leave LANGSMITH_TRACING unset to run without any tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=nexusgtm

NEXUSGTM_DB=nexusgtm.db

# --- Clay (RevOps) ------------------------------------------------------------
# Personal API key, from Settings -> Account -> API keys (beta):
# https://app.clay.com/workspaces/~/settings/account?accountTab=api-keys-beta
# It travels on Clay's own `clay-api-key` header, not an Authorization bearer.
CLAY_API_KEY=

# Build ONE company-enrichment function in Clay that returns firmographics AND
# the four signal columns, then paste its id here. Custom function ids look like
# `function:t_abc123` and are shown in the UI on the function itself.
#
# The function's signal outputs must be named exactly `Total Jobs Found`,
# `Funding Stage`, `Latest Funding Amount`, `Last Funding Date`, `News Title`
# (then `News Title 2`, `News Title 3`), `Publish Date` (likewise) and
# `Product Names` -- clay_enrich reads one name per field, not a list of guesses,
# so an output named anything else reads as no data at all. The README has the
# full tick-list and what to leave off. Do NOT add an AI column that synthesises
# them into a signals string -- that is what hits Clay's AI-column token limit,
# and clay_enrich turns them into short phrases in Python instead. Without this
# id clay_enrich returns status="error", which the planner treats as an
# observation and re-plans around -- the run still finishes.
CLAY_ENRICH_ROUTINE_ID=

# Clay bills credits, not tokens. Set your effective USD-per-credit so vendor
# spend reaches the same budget guardrail as LLM spend. Unset prices at 0.0,
# matching how an unknown model is priced rather than guessed.
CLAY_CREDIT_USD=

# Waterfall enrichment is asynchronous and can take tens of seconds. This bounds
# the poll; max_steps is a step ceiling, not a time ceiling.
CLAY_MAX_WAIT_S=120
CLAY_POLL_INTERVAL_S=3

# --- HubSpot (RevOps) ---------------------------------------------------------
# Private app token. Point this at a sandbox/test portal first -- a seed pass is
# a dozen runs. The quickest one to get is a developer test account: sign up at
# developers.hubspot.com, then Development -> Testing -> Create developer test
# account. It asks for a company name, not a website.
#
# Scopes:
#   crm.objects.contacts.read     crm_lookup matches on email first
#   crm.objects.companies.read    crm_lookup falls back to domain, then name
#   crm.objects.companies.write   crm_sync
#   crm.schemas.companies.write   scripts/hubspot_setup.py, to define properties
#   crm.objects.contacts.write    scripts/hubspot_setup.py --seed only
HUBSPOT_ACCESS_TOKEN=

# Only makes the record URL in crm_sync's output clickable; without it the URL
# points at the API instead. `hubspot_setup.py --check` prints yours.
HUBSPOT_PORTAL_ID=

# Run this once per portal before enabling writes. crm_sync names properties no
# portal has by default -- the run's verdict, and the `_inferred` half of the
# provenance split -- and HubSpot rejects a write naming a property it does not
# know, so without it the first live sync fails and so does every one after:
#
#   python scripts/hubspot_setup.py --check   # read-only: token, portal, gaps
#   python scripts/hubspot_setup.py           # create them
#   python scripts/hubspot_setup.py --seed    # records for crm_lookup to match

# Off by default. When false, crm_sync returns the payload it *would* have
# written with dry_run=true instead of touching the portal.
CRM_WRITE_ENABLED=false
